  <!-- Links from the tasks that fill in a date, a place or a name to the page that explains it (DEC-205).
       A table links both ways, so each concept page also lists the tasks. The tour and the sources page
       carry no date, place or name to fill in. The page of a family (Windows only) fills in a marriage
       date and a place, so its cell carries the Windows token. -->
  <reltable>
    <relheader>
      <relcolspec type="concept"/>
      <relcolspec type="task"/>
    </relheader>
    <relrow>
      <relcell>
        <topicref keyref="dates"/>
      </relcell>
      <relcell>
        <topicref keyref="add-another-person"/>
        <topicref keyref="change-a-person"/>
        <topicref keyref="add-a-family"/>
        <topicref keyref="see-a-familys-page" platform="WindowsWinUI"/>
