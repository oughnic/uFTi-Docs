<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the Windows manual. It holds the Start here chapter so far. Build it with
     build/scripts/build.ps1 -Project manual-windows (or build.sh). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="manual-windows">
    <context>
      <input href="../../content/ufti-manual-windows.ditamap"/>
      <profile>
        <ditaval href="../ditaval/windows.ditaval"/>
      </profile>
    </context>
    <output href="manual-windows"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi user manual: Windows"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/windows/"/>
      <param name="govuk.pdf.name" value="ufti-user-manual-windows"/>
    </publication>
  </deliverable>
</project>
