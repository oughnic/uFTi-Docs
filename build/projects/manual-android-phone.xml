<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the Android phone manual. It holds the Start here chapter so far. Build it with
     build/scripts/build.ps1 -Project manual-android-phone (or build.sh). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="manual-android-phone">
    <context>
      <input href="../../content/ufti-manual-android-phone.ditamap"/>
      <profile>
        <ditaval href="../ditaval/android-phone.ditaval"/>
      </profile>
    </context>
    <output href="manual-android-phone"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi user manual: Android phone"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/android-phone/"/>
      <param name="govuk.pdf.name" value="ufti-user-manual-android-phone"/>
    </publication>
  </deliverable>
</project>
