<?xml version="1.0" encoding="UTF-8"?>
<!-- Filter for the macOS manual (platform strategy, section 2.1). Every @platform value is
     excluded unless this manual owns it. An element with no @platform is always included.
     Tokens are case-sensitive and never renamed once published.
     The Mac manual documents Mac Catalyst (DEC-236, DEC-239). Its app is the iPad layout in a
     window, so it shares the iPad pages by its own token, MacCatalyst, rather than a group token.
     MacAppKit, Desktop and Pointer are no longer included: the AppKit pages stay in the source
     under MacAppKit, and the Desktop pages are for a computer that saves to the file you open. -->
<val>
  <prop att="platform" action="exclude"/>
  <prop att="platform" val="MacCatalyst" action="include"/>
</val>
