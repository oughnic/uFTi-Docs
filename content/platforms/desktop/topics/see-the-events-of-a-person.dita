<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="see-the-events-of-a-person" xml:lang="en-GB">
  <title>See the events of a person</title>
  <shortdesc>List what happened in a person's life, such as birth, marriage and death, and open any one.</shortdesc>
  <prolog>
    <critdates>
      <created date="2026-10-24"/>
    </critdates>
    <metadata>
      <audience type="user" experiencelevel="novice"/>
      <category>How-to</category>
      <keywords>
        <keyword>facts</keyword>
        <keyword>birth</keyword>
        <keyword>marriage</keyword>
        <keyword>death</keyword>
      </keywords>
    </metadata>
    <resourceid appname="ufti" appid="events.edit"/>
  </prolog>
  <taskbody>
    <prereq>
      <p>Open a person first. <xref keyref="find-a-person"/> shows how.</p>
    </prereq>
    <steps>
      <step>
        <cmd>Choose <uicontrol keyref="ui-events"/> in the menu.</cmd>
        <stepresult>
          <p>Each event has a line with its name, its date and its place. The small number at the right counts the <term keyref="term-source">sources</term> for it.</p>
          <fig>
            <image keyref="img-events"/>
          </fig>
        </stepresult>
      </step>
      <step>
        <cmd>Choose an event to open it.</cmd>
        <stepresult>
          <p>A page shows its type, date and place. It has a count of sources, a row of photo buttons, and the buttons <uicontrol keyref="ui-edit"/> and <uicontrol keyref="ui-delete-event"/>.</p>
          <fig>
            <image keyref="img-event-detail"/>
          </fig>
        </stepresult>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-all-events"/> to go back to the list.</cmd>
      </step>
    </steps>
    <result>
      <p>To add an event, choose <uicontrol keyref="ui-add-event"/> under the list.</p>
    </result>
    <postreq>
      <p>Next: <xref keyref="look-at-the-sources-of-a-fact"/>.</p>
    </postreq>
  </taskbody>
</task>
