  <publication transtype="html5" id="stock-html5">
    <param name="nav-toc" value="partial"/>
  </publication>
  <deliverable id="smoke-android-phone">
    <context>
      <input href="../fixtures/wp1/ufti-fixture-android-phone.ditamap"/>
      <profile><ditaval href="../ditaval/android-phone.ditaval"/></profile>
    </context>
    <output href="smoke-android-phone"/>
    <publication idref="stock-html5"/>
