# Build output and DITA-OT scratch (out-again and out-all are second builds for the determinism gate)
/out/
/out-*/
/temp/
/.dita-ot/
*.log

# Pinned tool downloads (see build/README.md)
/.tools/

# Local editor and OS files
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/

# Helper-tool dependencies, if checks use them
node_modules/
__pycache__/

# Public repository safety net: family-tree data must never be committed
*.ged
*.gdz
*.gedzip
/private/

# The one allowed place (DEC-111): the Brontë sample files the app bundles. Only *.ged, and
# build/scripts/check-samples.ps1 checks everything committed there.
!/content/sample-data/bronte/stages/*.ged
