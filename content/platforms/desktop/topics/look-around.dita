<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="look-around" xml:lang="en-GB">
  <title>Look around</title>
  <shortdesc>See what the main menu items show for the person you added.</shortdesc>
  <prolog>
    <critdates>
      <created date="2026-10-17"/>
    </critdates>
    <metadata>
      <audience type="user" experiencelevel="novice"/>
      <category>Get started</category>
      <keywords>
        <keyword>navigation</keyword>
        <keyword>menu</keyword>
      </keywords>
    </metadata>
    <resourceid appname="ufti" appid="people.view"/>
  </prolog>
  <taskbody>
    <prereq>
      <p>Add a person first.</p>
    </prereq>
    <context>
      <p>The menu at the left shows the main places. Most of them show the person you are looking at.</p>
    </context>
    <steps>
      <step>
        <cmd>Choose <uicontrol keyref="ui-person"/>.</cmd>
        <info>
          <p>It shows that person's page.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-events"/>.</cmd>
        <info>
          <p>It lists the <term keyref="term-fact">events and facts</term> for that person.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-notes"/>.</cmd>
        <info>
          <p>It shows the notes for that person.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-family-tree"/>.</cmd>
        <info>
          <p>It draws a tree. Older manuals call it a <term keyref="term-pedigree">pedigree</term>.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-add"/> at the top right.</cmd>
        <info>
          <p>A sheet named <uicontrol keyref="ui-add-a-record"/> lists what you can add.</p>
        </info>
      </step>
    </steps>
    <result>
      <p>The other menu items are for later. To go back one screen, choose the back arrow.</p>
      <fig platform="WindowsWinUI">
        <image keyref="img-person-view"/>
      </fig>
    </result>
    <postreq>
      <p>Next: <xref keyref="say-where-you-found-it"/>.</p>
    </postreq>
  </taskbody>
</task>
