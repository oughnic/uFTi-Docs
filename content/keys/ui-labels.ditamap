<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- The words on screen that the Windows app and the Android phone app both show, exactly as the app
     prints them (authoring standards, section 6; platform strategy, section 5), read from Windows
     app version 0.1.0.1 and Android app version 0.1.0 on 17 October 2026. Topics use
     <uicontrol keyref="ui-..."/> and never type a label inline, so a label that changes is corrected
     here once. A label that one device words differently is defined in that manual's own key map,
     which is included first, so its definition wins. -->
<map id="shared-ui-labels" xml:lang="en-GB">
  <!-- the main screens -->
  <keydef keys="ui-workspaces"><topicmeta><keywords><keyword>Workspaces</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-person"><topicmeta><keywords><keyword>Person</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-family"><topicmeta><keywords><keyword>Family</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-facts"><topicmeta><keywords><keyword>Facts</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-notes"><topicmeta><keywords><keyword>Notes</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-pedigree"><topicmeta><keywords><keyword>Pedigree</keyword></keywords></topicmeta></keydef>
  <!-- the top bar -->
  <keydef keys="ui-add"><topicmeta><keywords><keyword>+</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-search"><topicmeta><keywords><keyword>Search</keyword></keywords></topicmeta></keydef>
  <!-- the sheet that + opens -->
  <keydef keys="ui-add-a-record"><topicmeta><keywords><keyword>Add a record</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-add-a-new-person"><topicmeta><keywords><keyword>Add a new person</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-basic-details"><topicmeta><keywords><keyword>Basic details</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-add-button"><topicmeta><keywords><keyword>Add</keyword></keywords></topicmeta></keydef>
  <!-- the Workspaces screen -->
  <keydef keys="ui-create-workspace"><topicmeta><keywords><keyword>Create workspace</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-add-from-file"><topicmeta><keywords><keyword>Add from file…</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-new-workspace"><topicmeta><keywords><keyword>New workspace</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-create"><topicmeta><keywords><keyword>Create</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-save-as"><topicmeta><keywords><keyword>Save as…</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-save-workspace-as"><topicmeta><keywords><keyword>Save workspace as</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-gedcom-file"><topicmeta><keywords><keyword>GEDCOM file (.ged)</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-gedzip-archive"><topicmeta><keywords><keyword>GEDZIP archive (.gdz) — includes media</keyword></keywords></topicmeta></keydef>
  <!-- the form for a person -->
  <keydef keys="ui-given-names"><topicmeta><keywords><keyword>Given name(s)</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-surname"><topicmeta><keywords><keyword>Surname</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-sex"><topicmeta><keywords><keyword>Sex</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-save"><topicmeta><keywords><keyword>Save</keyword></keywords></topicmeta></keydef>
  <!-- a person's page and its sources -->
  <keydef keys="ui-birth"><topicmeta><keywords><keyword>Birth</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-sources"><topicmeta><keywords><keyword>Sources</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-add-source"><topicmeta><keywords><keyword>Add source</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-add-a-new-source"><topicmeta><keywords><keyword>Add a new source</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-title"><topicmeta><keywords><keyword>Title</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-save-source"><topicmeta><keywords><keyword>Save source</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-done"><topicmeta><keywords><keyword>Done</keyword></keywords></topicmeta></keydef>
</map>
