{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/windows/latest", "redirect": "/windows/Alpha-1/", "statusCode": 302 },
    { "route": "/windows/latest/start", "redirect": "/windows/Alpha-1/start/", "statusCode": 302 },
    { "route": "/windows/latest/*", "redirect": "/windows/Alpha-1/", "statusCode": 302 },
    { "route": "/android-phone/latest", "redirect": "/android-phone/Alpha-1/", "statusCode": 302 },
    { "route": "/android-phone/latest/start", "redirect": "/android-phone/Alpha-1/start/", "statusCode": 302 },
    { "route": "/android-phone/latest/*", "redirect": "/android-phone/Alpha-1/", "statusCode": 302 },
    { "route": "/android-tablet/latest", "redirect": "/android-tablet/Alpha-1/", "statusCode": 302 },
    { "route": "/android-tablet/latest/start", "redirect": "/android-tablet/Alpha-1/start/", "statusCode": 302 },
    { "route": "/android-tablet/latest/*", "redirect": "/android-tablet/Alpha-1/", "statusCode": 302 },
    { "route": "/iphone/latest", "redirect": "/iphone/Alpha-1/", "statusCode": 302 },
    { "route": "/iphone/latest/start", "redirect": "/iphone/Alpha-1/start/", "statusCode": 302 },
    { "route": "/iphone/latest/*", "redirect": "/iphone/Alpha-1/", "statusCode": 302 },
    { "route": "/ipad/latest", "redirect": "/ipad/Alpha-1/", "statusCode": 302 },
    { "route": "/ipad/latest/start", "redirect": "/ipad/Alpha-1/start/", "statusCode": 302 },
    { "route": "/ipad/latest/*", "redirect": "/ipad/Alpha-1/", "statusCode": 302 },
    { "route": "/macos/latest", "redirect": "/macos/Alpha-1/", "statusCode": 302 },
    { "route": "/macos/latest/start", "redirect": "/macos/Alpha-1/start/", "statusCode": 302 },
    { "route": "/macos/latest/*", "redirect": "/macos/Alpha-1/", "statusCode": 302 }
  ],
  "responseOverrides": { "404": { "rewrite": "/not-found.html" } },
  "globalHeaders": {
    "cache-control": "public, max-age=300, must-revalidate",
    "x-content-type-options": "nosniff",
    "referrer-policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": { ".pdf": "application/pdf" }
}
