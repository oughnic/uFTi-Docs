<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="say-where-you-found-it" xml:lang="en-GB">
  <title>Say where you found it</title>
  <shortdesc>Add a source to a fact, so you always know why you believe it.</shortdesc>
  <prolog>
    <critdates>
      <created date="2026-10-17"/>
    </critdates>
    <metadata>
      <audience type="user" experiencelevel="novice"/>
      <category>Get started</category>
      <keywords>
        <keyword>citation</keyword>
        <keyword>evidence</keyword>
        <keyword>reference</keyword>
      </keywords>
    </metadata>
    <resourceid appname="ufti" appid="citations.edit"/>
  </prolog>
  <taskbody>
    <prereq>
      <p>Open the page of a person who has a birth date.</p>
    </prereq>
    <steps>
      <step>
        <cmd>Choose the small chip beside <uicontrol keyref="ui-birth"/>.</cmd>
        <info>
          <p>It shows a number and a plus sign, such as 0 +.</p>
        </info>
        <stepresult>
          <p>A screen named <uicontrol keyref="ui-sources"/> opens.</p>
        </stepresult>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-add-source"/>, then <uicontrol keyref="ui-add-a-new-source"/>.</cmd>
      </step>
      <step>
        <cmd>In <uicontrol keyref="ui-title"/>, type where you know this from.</cmd>
        <info>
          <p>For example, <userinput>My birth certificate</userinput> or <userinput>Mum told me</userinput>. Only this box is needed.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-save-source"/>.</cmd>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-done"/>, then <uicontrol keyref="ui-done"/> again.</cmd>
        <stepresult>
          <p>The number on the chip goes up by one.</p>
        </stepresult>
      </step>
    </steps>
    <result>
      <p>The fact now has a <term keyref="term-source">source</term>. Later, when two records disagree, this is how you will know what to believe.</p>
      <fig>
        <image keyref="img-citation-add"/>
      </fig>
    </result>
    <postreq>
      <p>Next: <xref keyref="keep-it-safe"/>.</p>
    </postreq>
  </taskbody>
</task>
