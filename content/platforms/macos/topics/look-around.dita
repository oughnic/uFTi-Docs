<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<!-- Look around on the Mac (DEC-239). Written from the Mac Catalyst walk of 11 and 12 November 2026:
     the window is the iPad layout on its side, so a person's page always has the tree beside it. -->
<task id="look-around" xml:lang="en-GB">
  <title>Look around</title>
  <shortdesc>See what the places in the list on the left and the search box do for the person you added.</shortdesc>
  <prolog>
    <critdates>
      <created date="2026-11-12"/>
    </critdates>
    <metadata>
      <audience type="user" experiencelevel="novice"/>
      <category>Get started</category>
      <keywords>
        <keyword>navigation</keyword>
        <keyword>side list</keyword>
      </keywords>
    </metadata>
    <resourceid appname="ufti" appid="people.view"/>
  </prolog>
  <taskbody>
    <prereq>
      <p>Add a person first.</p>
    </prereq>
    <context>
      <p>The list down the left side of the window shows the main places. Most of them show the person you are looking at.</p>
    </context>
    <steps>
      <step>
        <cmd>Choose <uicontrol keyref="ui-person"/>.</cmd>
        <info>
          <p>It shows that person's page, with the family tree of that person beside it.</p>
        </info>
        <stepresult>
          <fig>
            <image keyref="img-person-view"/>
          </fig>
        </stepresult>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-events"/>.</cmd>
        <info>
          <p>It lists what happened in that person's life, such as a birth. Each one is a <term keyref="term-fact">fact</term>.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-family-tree"/>.</cmd>
        <info>
          <p>It draws a tree of that person, with parents above and children below.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-more"/>.</cmd>
        <info>
          <p>It lists <uicontrol keyref="ui-notes"/> and some other places. They are for later.</p>
        </info>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-home"/>, type a few letters of a name in the search box, then choose <uicontrol keyref="ui-search"/>.</cmd>
        <info>
          <p>Choose a card in the results to open that person.</p>
        </info>
      </step>
    </steps>
    <result>
      <p>To go back one screen, choose the back arrow at the top of the page.</p>
      <fig>
        <image keyref="img-nav-main"/>
      </fig>
    </result>
    <postreq>
      <p>Next: <xref keyref="say-where-you-found-it"/>.</p>
    </postreq>
  </taskbody>
</task>
