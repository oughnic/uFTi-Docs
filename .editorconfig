root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = unset

[*.{ps1,psm1}]
indent_size = 4

# Vendored licence texts stay exactly as their authors published them.
[build/theme/assets/licences/*]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,ico,pdf,zip,ttf,woff,woff2}]
charset = unset
end_of_line = unset
indent_size = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
