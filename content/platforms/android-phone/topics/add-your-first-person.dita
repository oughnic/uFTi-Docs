<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="add-your-first-person" xml:lang="en-GB">
  <title>Add your first person</title>
  <shortdesc>Make your own workspace and add yourself, or someone you know well.</shortdesc>
  <prolog>
    <critdates>
      <created date="2026-10-17"/>
      <revised modified="2026-11-10"/>
    </critdates>
    <metadata>
      <audience type="user" experiencelevel="novice"/>
      <category>Get started</category>
      <keywords>
        <keyword>new tree</keyword>
        <keyword>new person</keyword>
      </keywords>
    </metadata>
    <resourceid appname="ufti" appid="workspaces.create"/>
    <resourceid appname="ufti" appid="people.edit"/>
  </prolog>
  <taskbody>
    <steps>
      <step>
        <cmd>Choose <uicontrol keyref="ui-more"/>, then <uicontrol keyref="ui-workspaces"/>.</cmd>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-create-workspace"/>.</cmd>
        <stepresult>
          <p>A small box opens. It starts with a name already in the box.</p>
        </stepresult>
      </step>
      <step>
        <cmd>Clear the box. Type a name for your tree, such as My family, then choose <uicontrol keyref="ui-create"/>.</cmd>
        <info>
          <p>If the old name is still in the box, clear it first.</p>
        </info>
        <stepresult>
          <fig>
            <image keyref="img-create-workspace-dialog"/>
          </fig>
          <p>The new tree opens on <uicontrol keyref="ui-home"/>. It says there are no people yet.</p>
        </stepresult>
      </step>
      <step>
        <cmd>Choose <uicontrol keyref="ui-add-the-first-person"/>.</cmd>
        <stepresult>
          <p>The <uicontrol keyref="ui-new-person"/> form opens.</p>
          <fig>
            <image keyref="img-person-add"/>
          </fig>
        </stepresult>
      </step>
      <step>
        <cmd>Type a first name in <uicontrol keyref="ui-given-names"/> and a last name in <uicontrol keyref="ui-surname"/>.</cmd>
        <info>
          <p>Start with yourself, or someone you know well. Only the first name is needed.</p>
        </info>
      </step>
      <step>
        <cmd>Scroll down and choose <uicontrol keyref="ui-save"/>.</cmd>
        <stepresult>
          <p>The page of that person opens. That is your first person.</p>
        </stepresult>
      </step>
    </steps>
    <postreq>
      <p>Next: <xref keyref="look-around"/>.</p>
    </postreq>
  </taskbody>
</task>
