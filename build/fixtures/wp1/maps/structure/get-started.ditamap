    <relheader>
      <relcolspec type="concept"/>
      <relcolspec type="task"/>
    </relheader>
    <relrow>
      <relcell>
        <topicref keyref="workspaces"/>
        <topicref keyref="find-your-way-around" platform="Phone"/>
      </relcell>
      <relcell>
        <topicref keyref="add-a-person"/>
      </relcell>
    </relrow>
  </reltable>
</map>
