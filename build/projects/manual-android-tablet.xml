<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the Android tablet manual. It holds the Start here chapter so far.
     Its address, PDF name and footer links come from the release in build/publications.ini. Build it
     with build/scripts/build.ps1 -Project manual-android-tablet (or build.sh). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="manual-android-tablet">
    <context>
      <input href="../../content/ufti-manual-android-tablet.ditamap"/>
      <profile>
        <ditaval href="../ditaval/android-tablet.ditaval"/>
      </profile>
    </context>
    <output href="manual-android-tablet"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi user manual: Android tablet"/>
    </publication>
  </deliverable>
</project>
