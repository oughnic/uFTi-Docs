<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- The Android phone manual's pictures (platform strategy, section 4). Key names are the same in
     every manual, so one topic serves them all. A key's link text is the picture's alternative text
     (DEC-011): one sentence about what the picture shows and why it matters. The importer
     (build/scripts/Import-Screenshots.ps1) writes the files and keeps this map in step; it never
     rewrites alternative text. -->
<map id="android-phone-images" xml:lang="en-GB">
  <topicmeta>
    <prodinfo>
      <prodname>uFTi</prodname>
      <vrmlist><vrm version="0.2.0.1"/></vrmlist>
      <platform>Android phone</platform>
    </prodinfo>
    <data name="reference-device" value="physical, 1080 x 2400, portrait"/>
    <data name="dataset" value="bronte"/>
  </topicmeta>
  <keydef keys="img-start-first-run" href="../images/start-first-run.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Home screen of the sample tree, Brontë family of Haworth, with its counts of people, families and events, a search box, and the bar of five places along the bottom</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-add" href="../images/person-add.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The New person form filled in for Patrick Brontë, with his names, his sex and the first boxes for his birth date</linktext></topicmeta>
  </keydef>
  <keydef keys="img-nav-main" href="../images/nav-main.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Home screen of a tree with people in it, with a search box, the buttons All people and Open another workspace, the people to continue with, and the bar of five places along the bottom</linktext></topicmeta>
  </keydef>
  <keydef keys="img-citation-add" href="../images/citation-add.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Citation form for a source, with boxes for the page or reference number, how reliable it is and the date of the entry</linktext></topicmeta>
  </keydef>
  <keydef keys="img-create-workspace-dialog" href="../images/create-workspace-dialog.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The New workspace box, with Brontë family of Haworth typed as the name and the Cancel and Create buttons below</linktext></topicmeta>
  </keydef>
  <keydef keys="img-workspaces" href="../images/workspaces.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Workspaces screen with one card for Brontë family of Haworth, marked Active, with its counts of people, families and events and the buttons Show details, Open, Save as and Remove</linktext></topicmeta>
  </keydef>
  <keydef keys="img-remove-workspace" href="../images/remove-workspace.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Remove workspace question, which says the family tree file is not deleted, with Cancel and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-save-as-choice" href="../images/save-as-choice.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Save workspace as choice, with Everything marked recommended, Family tree only, and a Cancel button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-save-as-version" href="../images/save-as-version.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The question Which version of GEDCOM, with GEDCOM 7 marked as recommended, GEDCOM 5.5.1 for older programs, and a Cancel button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-search-results" href="../images/search-results.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The results of a search for Currer, with Charlotte Brontë listed under People and a small badge that counts her sources</linktext></topicmeta>
  </keydef>
  <keydef keys="img-search-refine" href="../images/search-refine.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Refine by list under the search box, with check boxes for dates, sex, place, event type and sound-alike matches</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-view" href="../images/person-view.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The top of Charlotte Brontë's page, with her name, her other names, her birth and her death, and a small chip on each part that counts its sources</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-page" href="../images/person-page.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The top of Patrick Brontë's page, with his name, his sex and his birth, each part with a small chip that counts its sources</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-edit" href="../images/person-edit.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The form for changing Charlotte Brontë, with her other names, a married name and a pen name, each in its own row</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record" href="../images/add-record.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Add a record sheet for Patrick Branwell Brontë, with choices to add parents, an event, a note, a source or a citation</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record-lower" href="../images/add-record-lower.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Add a record sheet, with the forms that start a new person, and Family, Repository, Research note and Submitter for the whole tree</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record-more-forms" href="../images/add-record-more-forms.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Add a record sheet opened to its extra forms, with a line under each census form that says nobody in the tree was alive then</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-form" href="../images/family-form.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Family form for Patrick Brontë and Maria Branwell, with the two partners chosen and the new husband and wife boxes empty</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-children" href="../images/family-children.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Children part of the Family form, with a row for each of the six children of Patrick and Maria</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-page" href="../images/family-page.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The page for Patrick Brontë and Maria Branwell, with their marriage in 1812, the partners and a View family tree button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-tree" href="../images/family-tree.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The family tree of Patrick Brontë fitted to the screen, with his wife Maria Branwell beside him and their six children below</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-tree-charlotte" href="../images/family-tree-charlotte.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The family tree for Charlotte Brontë, with her parents above, her husband Arthur Bell Nicholls beside her and a button for her five brothers and sisters</linktext></topicmeta>
  </keydef>
  <keydef keys="img-events" href="../images/events.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The list of events for Patrick Branwell Brontë, with his birth, baptism and death in date order, each with a place and a count of sources</linktext></topicmeta>
  </keydef>
  <keydef keys="img-event-detail" href="../images/event-detail.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The page for the baptism of Patrick Branwell Brontë, with its type, date and place and a count of sources</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-list" href="../images/sources-list.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Sources sheet for a death, with one source, its title, and the buttons Copy, Citation, Edit and Remove</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-empty" href="../images/sources-empty.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Sources sheet for a death with no sources, with the words No sources for this fact yet, and the buttons Add source and Compare records that disagree</linktext></topicmeta>
  </keydef>
  <keydef keys="img-source-new" href="../images/source-new.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The form for a new source, with boxes for the title, the words copied from the record and a note, and the buttons for where it is kept</linktext></topicmeta>
  </keydef>
  <keydef keys="img-source-attach" href="../images/source-attach.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The first step of Add source, with a box to search for a source you already have and a button to add a new source</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-one" href="../images/sources-one.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Sources sheet for Emily Jane Brontë's death after one source has been added, with its title, the entry and a line that gives the quality of the evidence</linktext></topicmeta>
  </keydef>
  <keydef keys="img-notes" href="../images/notes.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Notes screen for Patrick Brontë, with a note shared with one other record, and the buttons Add note and Use an existing note</linktext></topicmeta>
  </keydef>
  <keydef keys="img-note-form" href="../images/note-form.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The note form, with a box for the note, the Format and Language lists, and Save and Cancel buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-repositories" href="../images/repositories.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Where records are kept screen, with one place, the Brontë Parsonage Museum, and its Edit and Delete buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-submitters" href="../images/submitters.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Who made this tree screen, with the name of a team marked as the default, and its Edit and Delete buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-research-notes" href="../images/research-notes.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Research questions and notes screen, with one open question about the name of Patrick Brontë and the Edit, Copy and Delete buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-preferences" href="../images/preferences.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Preferences screen, with four themes and Oxford and slate chosen, and three looks and Light chosen</linktext></topicmeta>
  </keydef>
  <keydef keys="img-home" href="../images/home.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Home screen of the Brontë family of Haworth tree, with its counts, a search box, All people and Open another workspace, and a list of the people opened last</linktext></topicmeta>
  </keydef>
  <keydef keys="img-more-list" href="../images/more-list.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The More list, with Workspaces, Notes, Where records are kept, Who made this tree, Research questions and notes, Preferences, About uFTi and Help</linktext></topicmeta>
  </keydef>
  <keydef keys="img-people-list" href="../images/people-list.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The list of all the people in the tree, with a card for each that shows the name, the years, the sources and the events</linktext></topicmeta>
  </keydef>
  <keydef keys="img-date-editor" href="../images/date-editor.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The date of birth in the form for Charlotte Brontë, with the day, the month and the year filled in and the line that says how the app reads the date</linktext></topicmeta>
  </keydef>
  <keydef keys="img-date-not-sure" href="../images/date-not-sure.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The date of birth in the form for Maria Brontë, set to between two dates, with the years 1813 and 1814 and the line that reads between 1813 and 1814</linktext></topicmeta>
  </keydef>
  <keydef keys="img-name-question" href="../images/name-question.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The question that says Test Person is already in this tree, with a button to use that person and a button to add a new person with the same name</linktext></topicmeta>
  </keydef>
  <keydef keys="img-compare-records" href="../images/compare-records.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta><linktext>The Evidence page for a place, which gives the conclusion and what the source says, with its quality</linktext></topicmeta>
  </keydef>
</map>