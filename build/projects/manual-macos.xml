<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the macOS manual. It holds the Start here chapter so far. Build it with
     build/scripts/build.ps1 -Project manual-macos (or build.sh). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="manual-macos">
    <context>
      <input href="../../content/ufti-manual-macos.ditamap"/>
      <profile>
        <ditaval href="../ditaval/macos.ditaval"/>
      </profile>
    </context>
    <output href="manual-macos"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi user manual: macOS"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/macos/"/>
      <param name="govuk.pdf.name" value="ufti-user-manual-macos"/>
    </publication>
  </deliverable>
</project>
