<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the Windows Quick Start, its own site, print document and PDF (content model,
     section 3). Build it with build/scripts/build.ps1 -Project quick-start-windows (or build.sh).
     The manual's address is /docs/windows/, and its Quick Start is under start/ (site strategy). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="quick-start-windows">
    <context>
      <input href="../../content/ufti-quick-start-windows.ditamap"/>
      <profile>
        <ditaval href="../ditaval/windows.ditaval"/>
      </profile>
    </context>
    <output href="quick-start-windows"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi Quick Start: Windows"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/windows/start/"/>
      <param name="govuk.pdf.name" value="ufti-quick-start-windows"/>
    </publication>
  </deliverable>
</project>
