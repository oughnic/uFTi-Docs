<?xml version="1.0" encoding="UTF-8"?>
<!-- Filter for the Android phone manual (platform strategy, section 2.1). Every @platform value is
     excluded unless this manual owns it. An element with no @platform is always included.
     Tokens are case-sensitive and never renamed once published. -->
<val>
  <prop att="platform" action="exclude"/>
  <prop att="platform" val="AndroidPhone" action="include"/>
  <prop att="platform" val="Android" action="include"/>
  <prop att="platform" val="Phone" action="include"/>
  <prop att="platform" val="Mobile" action="include"/>
  <prop att="platform" val="Touch" action="include"/>
</val>
