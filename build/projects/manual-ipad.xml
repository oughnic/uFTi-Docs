<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the iPad manual. It holds the Start here chapter so far. Build it with
     build/scripts/build.ps1 -Project manual-ipad (or build.sh). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="manual-ipad">
    <context>
      <input href="../../content/ufti-manual-ipad.ditamap"/>
      <profile>
        <ditaval href="../ditaval/ipad.ditaval"/>
      </profile>
    </context>
    <output href="manual-ipad"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi user manual: iPad"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/ipad/"/>
      <param name="govuk.pdf.name" value="ufti-user-manual-ipad"/>
    </publication>
  </deliverable>
</project>
