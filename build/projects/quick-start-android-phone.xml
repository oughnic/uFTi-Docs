<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the Android phone Quick Start, its own site, print document and PDF (content model,
     section 3). Build it with build/scripts/build.ps1 -Project quick-start-android-phone (or build.sh).
     The manual's address is /docs/android-phone/, and its Quick Start is under start/ (site strategy). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="quick-start-android-phone">
    <context>
      <input href="../../content/ufti-quick-start-android-phone.ditamap"/>
      <profile>
        <ditaval href="../ditaval/android-phone.ditaval"/>
      </profile>
    </context>
    <output href="quick-start-android-phone"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi Quick Start: Android phone"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/android-phone/start/"/>
      <param name="govuk.pdf.name" value="ufti-quick-start-android-phone"/>
    </publication>
  </deliverable>
</project>
