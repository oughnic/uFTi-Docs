# Normalise line endings: text is LF in the working tree on every platform, so
# diffs, checksums and DITA-OT output agree wherever the build runs.
* text=auto eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (screenshots, fonts, built artefacts)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.ttf binary
*.woff binary
*.woff2 binary

# The Brontë sample files are kept byte for byte, as the app wrote them (DEC-111)
/content/sample-data/bronte/stages/*.ged -text
