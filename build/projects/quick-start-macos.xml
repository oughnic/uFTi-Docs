<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the macOS Quick Start, its own site, print document and PDF (content model,
     section 3). Build it with build/scripts/build.ps1 -Project quick-start-macos (or build.sh).
     The manual's address is /docs/macos/, and its Quick Start is under start/ (site strategy). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="quick-start-macos">
    <context>
      <input href="../../content/ufti-quick-start-macos.ditamap"/>
      <profile>
        <ditaval href="../ditaval/macos.ditaval"/>
      </profile>
    </context>
    <output href="quick-start-macos"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi Quick Start: macOS"/>
      <param name="govuk.site.url" value="https://ufti.com/docs/macos/start/"/>
      <param name="govuk.pdf.name" value="ufti-quick-start-macos"/>
    </publication>
  </deliverable>
</project>
