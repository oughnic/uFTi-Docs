<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- The iPad manual's pictures (platform strategy, section 4). Key names are the same in every manual,
     so one topic serves them all. A key's link text is the picture's alternative text (DEC-011): one
     sentence about what the picture shows and why it matters. The importer
     (build/scripts/Import-Screenshots.ps1) writes the files and keeps this map in step; it never
     rewrites alternative text. -->
<map id="ipad-images" xml:lang="en-GB">
  <topicmeta>
    <prodinfo>
      <prodname>uFTi</prodname>
      <vrmlist><vrm version="0.2.0.993"/></vrmlist>
      <platform>iPad</platform>
    </prodinfo>
    <data name="reference-device" value="simulator, ipad_air_11_m4, 2360 x 1640, landscape"/>
    <data name="dataset" value="bronte"/>
  </topicmeta>
  <keydef keys="img-nav-main" href="../images/nav-main.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>Charlotte Brontë's page with her family tree beside it, the list of places on the left and the path to the page at the top</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-page" href="../images/person-page.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The lower part of Charlotte Brontë's page, with her family and the Photos buttons, and her family tree beside it</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-view" href="../images/person-view.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>Patrick Brontë's page with his family tree beside it: his wife Maria Branwell and their daughter Charlotte</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-add" href="../images/person-add.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The New person form, in one column, filled in with Patrick as the given name and Brontë as the surname</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-edit" href="../images/person-edit.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The form for changing Charlotte Brontë, in one column on the left, with her family tree still showing beside it</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record" href="../images/add-record.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Add a record sheet, with choices to add parents, an event, a note, a source or a citation for Patrick Brontë</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record-lower" href="../images/add-record-lower.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The lower part of the Add a record sheet, with the forms for a new person, the choices for the whole tree and More forms</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record-more-forms" href="../images/add-record-more-forms.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The opened More forms part of the Add a record sheet, where each census form for a year after the people in the tree died has a line under it that says nobody here was alive then</linktext></topicmeta>
  </keydef>
  <keydef keys="img-create-workspace-dialog" href="../images/create-workspace-dialog.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The New workspace box as it opens, with the name My family tree already in the box and the Cancel and Create buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-workspaces" href="../images/workspaces.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Workspaces screen with two cards side by side, Brontë family of Haworth (2), marked Active, and Brontë family of Haworth, each with its counts and buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-remove-workspace" href="../images/remove-workspace.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Remove workspace question, which says the family tree file on disk is not deleted, with Cancel and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-save-as-choice" href="../images/save-as-choice.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Save workspace as box, which says what each kind of copy keeps, with the choices Everything, marked recommended, and Family tree only</linktext></topicmeta>
  </keydef>
  <keydef keys="img-save-as-version" href="../images/save-as-version.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The box Which version of GEDCOM, with GEDCOM 7 marked as recommended and GEDCOM 5.5.1 for older programs</linktext></topicmeta>
  </keydef>
  <keydef keys="img-import-summary" href="../images/import-summary.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The box that opens after a family tree file is opened, which counts the people, families, events, sources and notes and says the chosen file is left as it was</linktext></topicmeta>
  </keydef>
  <keydef keys="img-search-results" href="../images/search-results.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The results of a search for Patrick in two columns, two people on the left, each with a count of sources and events, and one marriage on the right</linktext></topicmeta>
  </keydef>
  <keydef keys="img-search-refine" href="../images/search-refine.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Refine by list under the search box, with choices for dates, sex, place, event type and sound-alike matches, and Clear filters</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-form" href="../images/family-form.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The form for a new family in two columns, with the partners on the left and the date and place of the marriage on the right</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-children" href="../images/family-children.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The row for a child in the Family form, with Charlotte Brontë chosen as an existing person and boxes for a new child running across the row</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-page" href="../images/family-page.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The page for Patrick Brontë and Maria Branwell, with their marriage, the partners, the marriage date and place, and their daughter Charlotte</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-tree" href="../images/family-tree.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The family tree for Patrick Brontë, with his wife Maria Branwell beside him and their daughter Charlotte below</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-tree-charlotte" href="../images/family-tree-charlotte.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The family tree for Charlotte Brontë, with her parents above, her husband Arthur Bell Nicholls beside her and a button for her five brothers and sisters</linktext></topicmeta>
  </keydef>
  <keydef keys="img-tree-marriage" href="../images/tree-marriage.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The sheet that opens from the marriage mark, with the marriage of Patrick and Maria, their daughter Charlotte and an Open family record line</linktext></topicmeta>
  </keydef>
  <keydef keys="img-events" href="../images/events.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>Charlotte Brontë's list of events, which are birth, marriage and death, each with a date, a place and a count of sources, and an Add event button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-event-detail" href="../images/event-detail.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The page for Charlotte Brontë's birth, with its type, date and place on the left and the More details part on the right</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-list" href="../images/sources-list.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Sources screen for Charlotte's birth, with five books, each with its author, a quality line and Copy, Citation, Edit and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-empty" href="../images/sources-empty.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Sources screen for a fact with no sources, with the words No sources for this fact yet and the Add source and Compare records that disagree buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-source-new" href="../images/source-new.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The new source form, with boxes for the title, the words copied, a note, where it is kept and what it records, and More details opened to show the author</linktext></topicmeta>
  </keydef>
  <keydef keys="img-source-attach" href="../images/source-attach.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The step that offers a camera, a folder and a chain button to attach a copy of the source, and a Done button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-one" href="../images/sources-one.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Sources screen after one book has been added, with its author and page and the Copy, Citation, Edit and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-citation-add" href="../images/citation-add.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The step after Save source, headed Add The Life of Charlotte Brontë to this fact, with the page or reference number, how reliable it is and the date of the entry</linktext></topicmeta>
  </keydef>
  <keydef keys="img-notes" href="../images/notes.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Notes screen for Patrick Brontë, with his note about coming to Haworth and the Add note and Use an existing note buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-repositories" href="../images/repositories.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Where records are kept screen, with the Brontë Parsonage Museum listed, its Edit and Delete buttons and Notes (0)</linktext></topicmeta>
  </keydef>
  <keydef keys="img-submitters" href="../images/submitters.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Who made this tree screen, with a line that says the tree states no copyright and uFTi documentation listed as the default maker</linktext></topicmeta>
  </keydef>
  <keydef keys="img-research-notes" href="../images/research-notes.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Research questions and notes screen, with a question about where in County Down Patrick was born, marked Open, and Edit, Copy and Delete buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-preferences" href="../images/preferences.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Preferences screen, with four themes and Oxford and slate chosen, and three looks with Light chosen</linktext></topicmeta>
  </keydef>
  <keydef keys="img-note-form" href="../images/note-form.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The note form, with a note about Charlotte's pen name typed under Note, boxes for the format and the language, Translations, and Save and Cancel buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-start-first-run" href="../images/start-first-run.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Home screen of the sample tree, Brontë family of Haworth, as the app first opens, with the list of places on the left, its counts, a search box, and the All people and Open another workspace buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-home" href="../images/home.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Home screen of the Brontë family of Haworth tree, with the list of places on the left, a search box, All people and Open another workspace, and Charlotte Brontë under Continue with</linktext></topicmeta>
  </keydef>
  <keydef keys="img-more-list" href="../images/more-list.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The More list beside the list of places on the left, with Workspaces, Notes, Where records are kept, Who made this tree, Research questions and notes, Preferences, About uFTi and Help</linktext></topicmeta>
  </keydef>
  <keydef keys="img-people-list" href="../images/people-list.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The list of all the people in the tree, with a card for each that shows the name, the years, the sources and the events</linktext></topicmeta>
  </keydef>
  <keydef keys="img-date-editor" href="../images/date-editor.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The date of birth in the form for Charlotte Brontë, with the day, the month and the year filled in and the line that says how the app reads the date</linktext></topicmeta>
  </keydef>
  <keydef keys="img-date-not-sure" href="../images/date-not-sure.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The date of birth in the form for Maria Brontë, set to between two dates, with the years 1813 and 1814 and the line that reads between 1813 and 1814</linktext></topicmeta>
  </keydef>
  <keydef keys="img-name-question" href="../images/name-question.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The small box that says Patrick Brontë is already in this tree, with a button to use Patrick Brontë and a button to add a new person with the same name</linktext></topicmeta>
  </keydef>
  <keydef keys="img-compare-records" href="../images/compare-records.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The Evidence page for a place of birth, which gives the conclusion and what the source says, with its quality</linktext></topicmeta>
  </keydef>
  <keydef keys="img-open-other-program" href="../images/open-other-program.png" format="png" scope="local" platform="iPad">
    <topicmeta><linktext>The box that opens for a file another program made, with the buttons Make a GEDCOM 7 copy and Just look, a line under each that says what it does, and Cancel</linktext></topicmeta>
  </keydef>
</map>
