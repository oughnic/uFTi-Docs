<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Words on screen that only the Android phone app shows (authoring standards, section 6), exactly
     as the app prints them, read from app version 0.1.0 on 17 October 2026. The labels both devices
     show are in content/keys/ui-labels.ditamap. This map is included first, so a definition here
     wins. -->
<map id="android-phone-ui-labels" xml:lang="en-GB">
  <keydef keys="ui-more"><topicmeta><keywords><keyword>More</keyword></keywords></topicmeta></keydef>
</map>
