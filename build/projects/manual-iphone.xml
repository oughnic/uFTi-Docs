<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the iPhone manual. It holds the Start here chapter so far.
     Its address, PDF name and footer links come from the release in build/publications.ini. Build it
     with build/scripts/build.ps1 -Project manual-iphone (or build.sh). -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="manual-iphone">
    <context>
      <input href="../../content/ufti-manual-iphone.ditamap"/>
      <profile>
        <ditaval href="../ditaval/iphone.ditaval"/>
      </profile>
    </context>
    <output href="manual-iphone"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi user manual: iPhone"/>
    </publication>
  </deliverable>
</project>
