<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the root of the published tree, which lists the platforms (index.html), one page
     per platform that lists its versions (<platform>/index.html), and the page shown for an address
     that is not there (not-found.html). Its sources are DITA 1.3 written by build/scripts/build-site.ps1
     (or build-site.sh) from build/publications.ini into out/generated/site-root/, because the lists
     change whenever a release is added. No search, print document or PDF: it is a few short pages.
     Build it with build-site, not alone: it needs those sources. Its address and footer links come
     from the base address in build/publications.ini. -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="site-root">
    <context>
      <input href="../../out/generated/site-root/ufti-docs.ditamap"/>
    </context>
    <output href="site-root"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi documentation"/>
      <param name="govuk.search" value="no"/>
      <param name="govuk.print" value="no"/>
      <param name="govuk.pdf" value="no"/>
    </publication>
  </deliverable>
</project>
