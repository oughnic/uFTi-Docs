<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Product facts shared by every manual (authoring standards, section 6; platform strategy, section 5).
     Facts the standards keep out of topics (price, accounts, where data lives) are not here either. -->
<map id="product-keys" xml:lang="en-GB">
  <keydef keys="product-name">
    <topicmeta>
      <keywords><keyword translate="no">uFTi</keyword></keywords>
    </topicmeta>
  </keydef>
</map>
