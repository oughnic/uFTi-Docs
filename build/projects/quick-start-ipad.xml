<?xml version="1.0" encoding="UTF-8"?>
<!-- One deliverable: the iPad Quick Start, its own site, print document and PDF (content model,
     section 3). Build it with build/scripts/build.ps1 -Project quick-start-ipad (or build.sh).
     Its address, PDF name and footer links come from the release in build/publications.ini. -->
<project xmlns="https://www.dita-ot.org/project">
  <include href="common.xml"/>
  <deliverable id="quick-start-ipad">
    <context>
      <input href="../../content/ufti-quick-start-ipad.ditamap"/>
      <profile>
        <ditaval href="../ditaval/ipad.ditaval"/>
      </profile>
    </context>
    <output href="quick-start-ipad"/>
    <publication idref="ufti-manual">
      <param name="govuk.service.name" value="uFTi Quick Start: iPad"/>
    </publication>
  </deliverable>
</project>
