      </relcell>
    </relrow>
    <relrow>
      <relcell>
        <topicref keyref="places"/>
        <topicref keyref="names"/>
      </relcell>
      <relcell>
        <topicref keyref="add-another-person"/>
        <topicref keyref="change-a-person"/>
        <topicref keyref="add-a-family"/>
        <topicref keyref="see-a-familys-page" platform="WindowsWinUI"/>
      </relcell>
    </relrow>
  </reltable>
