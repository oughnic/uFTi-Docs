<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<!-- The iPhone manual (platform strategy, section 7; DEC-080): one bookmap at the root of the content
     folder (DEC-045). The pages written from the iPhone walk carry iPhone (DEC-183); the pages a phone and
     a tablet share carry Mobile or iOS. Chapters not yet written are left out, not stubbed. -->
<bookmap id="ufti-manual-iphone" xml:lang="en-GB">
  <booktitle>
    <mainbooktitle>uFTi user manual: iPhone</mainbooktitle>
    <booktitlealt>Understanding family tree information</booktitlealt>
  </booktitle>
  <bookmeta>
    <publisherinformation>
      <organization>Oughtibridge Ltd</organization>
    </publisherinformation>
    <bookrights>
      <copyrfirst><year>2026</year></copyrfirst>
      <bookowner><organization>Oughtibridge Ltd</organization></bookowner>
    </bookrights>
  </bookmeta>
  <frontmatter>
    <booklists>
      <toc/>
    </booklists>
  </frontmatter>
  <chapter href="topics/quick-start/quick-start.dita" keys="quick-start">
    <mapref href="platforms/iphone/keys/images.ditamap" platform="iPhone" processing-role="resource-only"/>
    <mapref href="platforms/iphone/keys/ui-labels.ditamap" platform="iPhone" processing-role="resource-only"/>
    <mapref href="keys/ui-labels.ditamap" processing-role="resource-only"/>
    <mapref href="keys/product.ditamap" processing-role="resource-only"/>
    <mapref href="maps/structure/quick-start.ditamap"/>
  </chapter>
  <chapter href="topics/quick-start/five-things-to-know.dita" keys="five-things-to-know"/>
  <chapter href="topics/tree/work-with-your-tree.dita" keys="work-with-your-tree">
    <mapref href="maps/structure/work-with-your-tree.ditamap"/>
  </chapter>
  <chapter href="topics/workspaces/bring-in-share-and-keep-safe.dita" keys="bring-in-share-and-keep-safe">
    <mapref href="maps/structure/bring-in-share-and-keep-safe.ditamap"/>
  </chapter>
  <backmatter>
    <booklists>
      <!-- toc="no": the print document and PDF make their own Glossary part, so the terms are not also printed as pages of their own (DEC-170). -->
      <glossarylist toc="no">
        <topicref href="glossary/backup.dita" keys="term-backup"/>
        <topicref href="glossary/fact.dita" keys="term-fact"/>
        <topicref href="glossary/family-tree-file.dita" keys="term-family-tree-file"/>
        <topicref href="glossary/gedcom.dita" keys="term-gedcom"/>
        <topicref href="glossary/gedzip.dita" keys="term-gedzip"/>
        <topicref href="glossary/pedigree.dita" keys="term-pedigree"/>
        <topicref href="glossary/saved-copy.dita" keys="term-saved-copy"/>
        <topicref href="glossary/source.dita" keys="term-source"/>
        <topicref href="glossary/workspace.dita" keys="term-workspace"/>
      </glossarylist>
    </booklists>
  </backmatter>
</bookmap>
