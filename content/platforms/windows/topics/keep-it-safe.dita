<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="keep-it-safe" xml:lang="en-GB">
  <title>Keep it safe</title>
  <shortdesc>Save a copy of your tree as a file, and keep it somewhere else too.</shortdesc>
  <prolog>
    <critdates>
      <created date="2026-10-17"/>
    </critdates>
    <metadata>
      <audience type="user" experiencelevel="novice"/>
      <category>Get started</category>
      <keywords>
        <keyword>backup</keyword>
        <keyword>copy</keyword>
      </keywords>
    </metadata>
    <resourceid appname="ufti" appid="workspaces.export"/>
  </prolog>
  <taskbody>
    <steps>
      <step>
        <cmd>Open <uicontrol keyref="ui-workspaces"/>.</cmd>
      </step>
      <step>
        <cmd>On the card for your tree, choose <uicontrol keyref="ui-save-as"/>.</cmd>
        <stepresult>
          <p>A small sheet named <wintitle keyref="ui-save-workspace-as"/> opens.</p>
        </stepresult>
      </step>
      <step>
        <cmd>Choose how to save your tree.</cmd>
        <choices>
          <choice><uicontrol keyref="ui-gedcom-file"/> saves your tree as a family tree file.</choice>
          <choice><uicontrol keyref="ui-gedzip-archive"/> saves it with any pictures as well.</choice>
        </choices>
      </step>
      <step>
        <cmd>When Windows asks where to put the file, choose a folder you will remember.</cmd>
      </step>
    </steps>
    <result>
      <p>You now have a copy. Make a new copy after you add a lot. Keep one on a USB stick or another drive too.</p>
    </result>
    <postreq>
      <p>Next: <xref keyref="what-next"/>.</p>
    </postreq>
  </taskbody>
</task>
