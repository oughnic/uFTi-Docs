<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- The Android phone manual's image keys (platform strategy, section 4). Key names are the same in every
     manual, so one topic serves them all. The key's link text is the alternative text (DEC-011).
     The pictures are drawn placeholders, not screenshots: the fixture never shows the app. -->
<map id="android-phone-images" xml:lang="en-GB">
  <topicmeta>
    <prodinfo>
      <prodname>uFTi</prodname>
      <vrmlist><vrm version="0.0"/></vrmlist>
      <platform>Android phone</platform>
    </prodinfo>
    <data name="reference-device" value="placeholder: no device, no app build"/>
    <data name="dataset" value="placeholder: no data shown"/>
  </topicmeta>
  <keydef keys="img-person-view" href="../images/person-view.png" format="png" scope="local" platform="AndroidPhone">
    <topicmeta>
      <linktext>The person page on a phone, with the name at the top and the Edit button at the bottom</linktext>
    </topicmeta>
  </keydef>
</map>
