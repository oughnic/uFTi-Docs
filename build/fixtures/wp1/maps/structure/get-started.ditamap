<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- The shared chapter map: the same navigation for every manual. A topic that exists for one
     idiom only carries @platform on its topicref, here and in the relationship table. -->
