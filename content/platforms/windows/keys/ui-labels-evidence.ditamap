<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Words on screen for the chapter "Events, notes and sources" in the Windows manual (authoring
     standards, section 6), exactly as the app prints them, read from the Alpha-2 walk on 10 November 2026.
     Included by the chapter's own map, maps/structure/windows-evidence.ditamap, with processing-role
     resource-only. Each key here still needs a row in the terminology list, section 2 (the lint keeps that
     list whole): the writer of the terminology list adds them. A label that already has a key in
     content/keys/ui-labels.ditamap, content/platforms/windows/keys/ui-labels.ditamap or
     content/platforms/windows/keys/ui-labels-quick-start.ditamap or ui-labels-workspaces.ditamap (which
     defines ui-add-to-the-workspace, used here) is not repeated here. -->
<map id="windows-ui-labels-evidence" xml:lang="en-GB">
  <!-- the Add a record list -->
  <keydef keys="ui-add-an-event-to"><topicmeta><keywords><keyword>Add an event to</keyword></keywords></topicmeta></keydef>
