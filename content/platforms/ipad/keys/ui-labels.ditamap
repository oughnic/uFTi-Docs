<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Words on screen that the iPad app shows and the shared map does not, exactly as the app prints
     them, read from the current dev build (shown as version 0.1.0 (1)) on 31 October 2026 on an iPad
     simulator in landscape. They are the iPhone's words: the iPad shows the same labels, in a list down
     the left side in place of the bar along the bottom. The labels every device shows are in
     content/keys/ui-labels.ditamap. This map is included first, so a definition here wins: it also
     replaces the shared labels whose words are different on a phone or a tablet (the list of places and
     the two choices for a copy). -->
<map id="ipad-ui-labels" xml:lang="en-GB">
  <!-- the list of places down the left side, and the list its last place opens -->
  <keydef keys="ui-more"><topicmeta><keywords><keyword>More</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-gedzip-archive"><topicmeta><keywords><keyword>Everything (.gdz, recommended)</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-gedcom-file"><topicmeta><keywords><keyword>Family tree only (.ged)</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-family-tree"><topicmeta><keywords><keyword>Family tree</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-events"><topicmeta><keywords><keyword>Events</keyword></keywords></topicmeta></keydef>
  <keydef keys="ui-where-records-are-kept"><topicmeta><keywords><keyword>Where records are kept</keyword></keywords></topicmeta></keydef>
