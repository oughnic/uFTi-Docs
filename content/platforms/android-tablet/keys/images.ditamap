<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- The Android tablet manual's pictures (platform strategy, section 4). Key names are the same in
     every manual, so one topic serves them all. A key's link text is the picture's alternative text
     (DEC-011): one sentence about what the picture shows and why it matters. The importer
     (build/scripts/Import-Screenshots.ps1) writes the files and keeps this map in step; it never
     rewrites alternative text. -->
<map id="android-tablet-images" xml:lang="en-GB">
  <topicmeta>
    <prodinfo>
      <prodname>uFTi</prodname>
      <vrmlist><vrm version="0.2.0.993"/></vrmlist>
      <platform>Android tablet</platform>
    </prodinfo>
    <data name="reference-device" value="emulator, 2560 x 1600, landscape"/>
    <data name="dataset" value="bronte"/>
  </topicmeta>
  <keydef keys="img-start-first-run" href="../images/start-first-run.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The top of the Workspaces screen, with its heading, a line saying each workspace is one family tree file, and the Create workspace and Add from file buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-add" href="../images/person-add.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The New person form for Patrick Brontë, with his given name, surname and sex in one column and, beside it, a Family tree area that says to pick a person</linktext></topicmeta>
  </keydef>
  <keydef keys="img-nav-main" href="../images/nav-main.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>Search results for Patrick, with two people on the left and one marriage on the right, and the list of places down the left side of the screen</linktext></topicmeta>
  </keydef>
  <keydef keys="img-citation-add" href="../images/citation-add.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The step after Save source, which asks for the page or reference number, how reliable the source is, the date and the words of the entry, with an Add source button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-create-workspace-dialog" href="../images/create-workspace-dialog.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The New workspace box, with Brontë family of Haworth typed as the name and the Cancel and Create buttons below</linktext></topicmeta>
  </keydef>
  <keydef keys="img-workspaces" href="../images/workspaces.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Workspaces screen with one card, Brontë family of Haworth, marked Active, which says how many people, families and events it holds and has Open, Save as and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-remove-workspace" href="../images/remove-workspace.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Remove workspace question, which says the family tree file is not deleted, with Cancel and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-save-as-choice" href="../images/save-as-choice.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Save workspace as choice, with Everything marked recommended, Family tree only, and a Cancel button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-save-as-version" href="../images/save-as-version.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The question Which version of GEDCOM, with GEDCOM 7 marked as recommended, GEDCOM 5.5.1 for older programs, and a Cancel button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-import-summary" href="../images/import-summary.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The box that opens after a file is opened, which counts the people, families, events, sources and notes and says the chosen file is left as it was</linktext></topicmeta>
  </keydef>
  <keydef keys="img-search-results" href="../images/search-results.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The results of a search for Patrick, with two people in one column and one marriage in the other, and small chips on each person that count their sources, events and notes</linktext></topicmeta>
  </keydef>
  <keydef keys="img-search-refine" href="../images/search-refine.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Refine by list under the search box, with check boxes for dates, sex, place, event type and sound-alike matches</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-view" href="../images/person-view.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>Charlotte Brontë's page, with her names, birth and death in one column and her family tree beside it</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-page" href="../images/person-page.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>Patrick Brontë's page, with his names and sex, birth and death in one column and his family tree beside it, with a divider between the two</linktext></topicmeta>
  </keydef>
  <keydef keys="img-person-edit" href="../images/person-edit.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The form for changing Charlotte Brontë, with her names and sex in one column and her family tree beside it</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record" href="../images/add-record.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Add a record sheet for Patrick Brontë, with choices to add parents, an event, a note, a source or a citation</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record-lower" href="../images/add-record-lower.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The lower part of the Add a record sheet, with the choices for a new person, the Family, Repository, Research note and Submitter choices, and the Add and Cancel buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-add-record-more-forms" href="../images/add-record-more-forms.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The opened More forms part of the Add a record sheet, where each census form for a year after the people in the tree died has a line under it that says nobody here was alive then</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-form" href="../images/family-form.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The form for changing the family of Patrick Brontë and Maria Branwell, with the partners on the left and the marriage date and place on the right</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-children" href="../images/family-children.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Children part of the Family form, with a row for each child, each chosen from the people already in the tree</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-page" href="../images/family-page.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The page for Patrick Brontë and Maria Branwell, with their marriage, their six children and a View family tree button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-tree" href="../images/family-tree.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The family tree for Patrick Brontë, with his wife Maria Branwell beside him and their six children below</linktext></topicmeta>
  </keydef>
  <keydef keys="img-family-tree-charlotte" href="../images/family-tree-charlotte.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The family tree for Charlotte Brontë, with her parents above, her husband Arthur Bell Nicholls beside her and a button for her brothers and sisters</linktext></topicmeta>
  </keydef>
  <keydef keys="img-tree-marriage" href="../images/tree-marriage.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The sheet that opens from the marriage mark, with the marriage of Patrick and Maria, each of their children and an Opens the family line</linktext></topicmeta>
  </keydef>
  <keydef keys="img-events" href="../images/events.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>Charlotte Brontë's list of events, which are birth, marriage and death, each with a date and a place, and an Add event button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-event-detail" href="../images/event-detail.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The page for Charlotte Brontë's birth, with its type, date and place, a source count and a part for more details</linktext></topicmeta>
  </keydef>
  <keydef keys="img-date-editor" href="../images/date-editor.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The form for an event of Charlotte Brontë, with the date boxes filled in as 21 April 1816 and the line under them that says Reads as 21 April 1816</linktext></topicmeta>
  </keydef>
  <keydef keys="img-date-not-sure" href="../images/date-not-sure.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The date in the form for an event, with Not sure of the date turned on and set to between two dates, with the years 1813 and 1814 and the line that reads between 1813 and 1814</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-list" href="../images/sources-list.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Sources screen for Charlotte's birth, with two sources, each with Copy, Citation, Edit and Remove buttons, and below them the Add source and Compare records that disagree buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-empty" href="../images/sources-empty.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Sources screen for a birth with no sources, with the words No sources for this fact yet, an Add source button and a Done button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-source-new" href="../images/source-new.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The new source form, with boxes for the title, the words copied and a note, parts for where it is kept and what it records, and a Save source button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-source-attach" href="../images/source-attach.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The step after Save source, which offers a camera, a folder and a chain button to attach a copy of the source, and a Done button</linktext></topicmeta>
  </keydef>
  <keydef keys="img-sources-one" href="../images/sources-one.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Sources screen after one book has been added, with its page and the Copy, Citation, Edit and Remove buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-notes" href="../images/notes.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Notes screen for Patrick Brontë, listing a note that says he became perpetual curate of Haworth, with the Add note and Use an existing note buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-note-form" href="../images/note-form.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The note form, with a box for the note, Format and Language lists, a Translations part, and Save and Cancel buttons</linktext></topicmeta>
  </keydef>
  <keydef keys="img-repositories" href="../images/repositories.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Where records are kept screen, listing West Yorkshire Archive Service, Bradford, with Edit and Delete</linktext></topicmeta>
  </keydef>
  <keydef keys="img-submitters" href="../images/submitters.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Who made this tree screen, listing uFTi documentation as the default, with Edit and Delete</linktext></topicmeta>
  </keydef>
  <keydef keys="img-research-notes" href="../images/research-notes.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Research questions and notes screen, listing the question about the Thornton baptism marked Open, with Edit, Copy and Delete</linktext></topicmeta>
  </keydef>
  <keydef keys="img-preferences" href="../images/preferences.png" format="png" scope="local" platform="AndroidTablet">
    <topicmeta><linktext>The Preferences screen, with four themes and Oxford and slate chosen, and three looks and Light chosen</linktext></topicmeta>
  </keydef>
</map>
